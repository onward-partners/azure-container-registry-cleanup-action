{
  "name": "@i40mc/azure-container-registry-cleanup-action",
  "private": true,
  "version": "2.2.5",
  "description": "This action cleans up old image tags in an Azure Container Registry",
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint src/**/*.ts",
    "package": "npx rimraf ./dist && npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i40mc/azure-container-registry-cleanup-action.git"
  },
  "keywords": [
    "actions",
    "azure",
    "acr"
  ],
  "author": "scomans",
  "license": "MIT",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@azure/container-registry": "^1.1.2",
    "@azure/identity": "^4.13.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-plugin-github": "^6.1.2",
    "globals": "^17.11.0",
    "js-yaml": "^5.4.1",
    "prettier": "3.9.6",
    "rollup": "^4.63.1",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  }
}
